		{
			"name": "3. Pointage & Synchronisation Offline",
			"item": [
				{
					"name": "Pointer via QR Code (Sur site)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"qr_token\": \"EMP-QR-JEAN-DUPONT-TEST-TOKEN-001\",\n    \"latitude\": 48.8698,\n    \"longitude\": 2.3314\n}"
						},
						"url": {
							"raw": "{{base_url}}/clock/punch",
							"host": ["{{base_url}}"],
							"path": ["clock", "punch"]
						}
					}
				},
				{
					"name": "Pointer via Code PIN (4 chiffres)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"pin_code\": \"1234\",\n    \"latitude\": 48.8698,\n    \"longitude\": 2.3314\n}"
						},
						"url": {
							"raw": "{{base_url}}/clock/punch",
							"host": ["{{base_url}}"],
							"path": ["clock", "punch"]
						}
					}
				},
				{
					"name": "Synchronisation Batch Offline (avec Idempotence)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{employee_token}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"punches\": [\n        {\n            \"offline_id\": \"test-uuid-offline-001\",\n            \"type\": \"in\",\n            \"punched_at\": \"2026-11-23T08:00:00Z\",\n            \"latitude\": 48.8698,\n            \"longitude\": 2.3314\n        },\n        {\n            \"offline_id\": \"test-uuid-offline-002\",\n            \"type\": \"out\",\n            \"punched_at\": \"2026-11-23T12:00:00Z\",\n            \"latitude\": 48.8698,\n            \"longitude\": 2.3314\n        }\n    ]\n}"
						},
						"url": {
							"raw": "{{base_url}}/clock/sync",
							"host": ["{{base_url}}"],
							"path": ["clock", "sync"]
						}
					}
				},
				{
					"name": "Historique des pointages (Employé)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{employee_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/employee/history",
							"host": ["{{base_url}}"],
							"path": ["employee", "history"]
						}
					}
				}
			]
		},
		{
