Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block hidden files and directories, except the standard ACME challenge path.
    RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L]

    # Never serve Laravel source, runtime data, or dependency files directly.
    RewriteRule ^(?:app|bootstrap|config|database|resources|routes|storage|tests|vendor)(?:/|$) - [F,L,NC]
    RewriteRule ^(?:artisan|composer\.(?:json|lock)|phpunit\.xml|package(?:-lock)?\.json|vite\.config\.js)(?:/|$) - [F,L,NC]

    RewriteRule ^(?:front|logo)(?:/|$) - [F,L,NC]

    # Do not rewrite requests that already target Laravel's public directory.
    RewriteRule ^public(?:/|$) - [L,NC]

    # Serve the project through Laravel's actual public directory.
    RewriteRule ^(.*)$ public/$1 [L,QSA]
</IfModule>
